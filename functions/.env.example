# Copied to functions/.env (git-ignored) and loaded by Firebase Functions at deploy.
# Used by scheduled/checkPaymentGrants to email the daily paid-but-no-plan audit.
RESEND_API_KEY=
RESEND_FROM=Sol Pilates Studio <alerts@solpilatesstudio.in>
ADMIN_ALERT_EMAIL=
# Used by scheduled/retryDeferredCancellations to stop renewal for late cancellations.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
